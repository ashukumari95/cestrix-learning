# PostgreSQL Database Connection String
# Example for local: postgresql://postgres:password@localhost:5432/cestrix_db?schema=public
# Example for cloud (Supabase, Neon, AWS): postgresql://user:password@cloud-url.com:5432/db_name?schema=public
DATABASE_URL=""

# JWT Secrets for Authentication
JWT_SECRET="super_secret_jwt_key_here"
JWT_REFRESH_SECRET="super_secret_refresh_key_here"

# Server Port
PORT=5000
